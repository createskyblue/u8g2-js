{
  "name": "u8g2-js",
  "version": "1.0.0",
  "description": "U8G2 monochrome graphics library ported to pure JavaScript for browser simulation. Pixel-faithful to the original C library.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src/",
    "tools/",
    "fonts/",
    "demo/",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "build:demo": "node tools/build-demo.js",
    "check:demo": "node tools/check-demo.js",
    "check:chinese-fonts": "node tools/check-chinese-fonts.js",
    "fonts:build": "node tools/convert-all-fonts.js",
    "fonts:verify": "node tools/verify-font-pack.mjs",
    "cverify": "bash tools/cverify/build.sh"
  },
  "keywords": [
    "u8g2",
    "oled",
    "lcd",
    "e-paper",
    "embedded",
    "graphics",
    "simulator",
    "monochrome"
  ],
  "author": "olikraus (original C library); ported for browser simulation",
  "license": "BSD-2-Clause",
  "engines": {
    "node": ">=18"
  }
}
